{
	"name": "closemarketing/connect-ecommerce",
	"description": "Connects Ecommerce to ERP/CRM Systems",
	"homepage": "https://close.technology/",
	"license": "GPL-2.0-or-later",
	"config": {
		"platform": {
			"php": "8.3"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"require": {
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3",
		"dealerdirect/phpcodesniffer-composer-installer": "^0.7",
		"phpcompatibility/phpcompatibility-wp": "^2",
		"sirbrillig/phpcs-variable-analysis": "^2",
		"wp-coding-standards/wpcs": "^2",
		"phpcsstandards/phpcsutils": "^1.x-dev",
		"phpunit/phpunit": "^9.0",
		"yoast/phpunit-polyfills": "^1.0"
	},
	"scripts": {
    "behat": "BEHAT_FEATURES_FOLDER=tests/behat/features run-behat-tests",
    "behat-rerun": "BEHAT_FEATURES_FOLDER=tests/behat/features rerun-behat-tests",
    "format": "phpcbf --standard=phpcs.xml.dist",
    "lint": "phpcs --standard=phpcs.xml.dist",
    "phpmd": "phpmd . text phpmd.xml",
    "phpstan": "phpstan analyse --memory-limit=2048M",
    "prepare-behat-tests": "install-package-tests",
    "test": "phpunit"
  },
	"autoload-dev": {
		"classmap": [
			"./vendor/wp-coding-standards/wpcs/"
		]
	}
}
